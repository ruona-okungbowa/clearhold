# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Runs the inspector and the control room's desk agent. With no key, the desk's AG Studio assistant is hidden.
ANTHROPIC_API_KEY=

# Optional: comma-separated Claude model ids for the assistant's model picker; the first is the default.
# Must take thinking type between_tools, which today means claude-sonnet-5-5. If blank, the inspector's model is used.
ANTHROPIC_MODELS=

# Signs the renter's evidence-page link (/r/<token>); at least 32 characters, e.g. `openssl rand -base64 32`.
RENTER_LINK_SECRET=
